{
  "compilerOptions": {
    // "strict" liga todas as verificações rigorosas do TypeScript de uma vez.
    // É o que faz o compilador acusar, por exemplo, uma variável que pode ser
    // nula sendo usada sem verificação. É justamente esse rigor que sustenta o
    // argumento da monografia sobre detecção antecipada de defeitos.
    "strict": true,
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // O apelido "@/" evita caminhos relativos longos como "../../../lib/utils".
    // Qualquer import pode ser escrito a partir da raiz de src.
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
