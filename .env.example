# URL do projeto. Tem o prefixo NEXT_PUBLIC porque tambem e usada no navegador.
NEXT_PUBLIC_SUPABASE_URL=${YOUR_SUPABASE_URL}

# Chave publica, segura para o navegador. Respeita as politicas de RLS.
# Substitui a antiga chave anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${YOUR_SUPABASE_PUBLISHABLE_KEY}

# Chave secreta, ignora o RLS. NUNCA deve aparecer em codigo entregue ao
# navegador nem ser commitada. Sem o prefixo NEXT_PUBLIC justamente para que o
# Next.js nunca a exponha no bundle do cliente.
# Substitui a antiga chave service_role.
SUPABASE_SECRET_KEY=${YOUR_SUPABASE_SECRET_KEY}

# Senha das contas criadas por scripts/seed-usuarios.mts. Vale so em ambiente
# de demonstracao: as contas sao ficticias e o banco nao e de producao.
SEED_USER_PASSWORD=${YOUR_SEED_PASSWORD}

# Endereco que recebe as notificacoes na demonstracao. Sem dominio verificado,
# o Resend so entrega no e-mail dono da conta, entao o professor de
# demonstracao passa a usar este endereco.
SEED_DEMO_EMAIL=${YOUR_EMAIL}

# Chave da API do Resend, em Resend > API Keys.
RESEND_API_KEY=${YOUR_RESEND_API_KEY}

# Remetente das notificacoes, num dominio verificado no Resend. Sem dominio, o
# unico valor aceito e CheckRoom <onboarding@resend.dev>, que so entrega no
# e-mail do dono da conta.
RESEND_FROM=${YOUR_RESEND_FROM}

# Contas que entram sem segundo fator, separadas por vírgula. Só valem em
# desenvolvimento: em produção o código ignora esta variável. Exemplo:
# adm@umc.br,professor@umc.br
MFA_DISPENSADO_PARA=${YOUR_ACCOUNTS_WITHOUT_MFA}

# Endereco publico do sistema, usado nos links dos e-mails (convite e
# recuperacao de senha). Em desenvolvimento, http://localhost:3000. Na Vercel,
# o dominio publicado.
SITE_URL=${YOUR_SITE_URL}
