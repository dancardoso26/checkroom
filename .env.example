# Copie este arquivo para .env.local e preencha com os valores do seu projeto
# no Supabase, em Project Settings > API Keys.
#
# O .env.local NAO vai para o repositorio, ja esta coberto pelo .gitignore.
# Este arquivo de exemplo vai, para que qualquer pessoa saiba quais variaveis
# precisa configurar.
#
# SOBRE OS NOMES DAS CHAVES
#
# O Supabase renomeou suas chaves de API. As antigas anon e service_role, que
# eram JWTs comecando com eyJ, deram lugar a publishable e secret, com prefixos
# sb_publishable_ e sb_secret_. As antigas continuam funcionando, mas o proprio
# painel indica as novas como preferenciais, e sao elas que este projeto usa.

# URL do projeto. Tem o prefixo NEXT_PUBLIC porque tambem e usada no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publica, segura para o navegador. Respeita as politicas de RLS.
# Substitui a antiga chave anon.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave

# Chave secreta, ignora o RLS. NUNCA deve aparecer em codigo entregue ao
# navegador nem ser commitada. Sem o prefixo NEXT_PUBLIC justamente para que o
# Next.js nunca a exponha no bundle do cliente.
# Substitui a antiga chave service_role.
SUPABASE_SECRET_KEY=sb_secret_sua-chave

# Senha das contas criadas por scripts/seed-usuarios.ts. Vale so em ambiente de
# demonstracao: as contas sao ficticias e o banco nao e de producao.
SEED_USER_PASSWORD=troque-esta-senha

# Endereco que recebe as notificacoes na demonstracao. Sem dominio verificado,
# o Resend so entrega no e-mail dono da conta, entao o professor de
# demonstracao passa a usar este endereco.
SEED_DEMO_EMAIL=seu-email@exemplo.com

# Chave da API do Resend, em Resend > API Keys.
RESEND_API_KEY=re_sua-chave

# Remetente das notificacoes. Enquanto nao houver dominio verificado, o unico
# valor aceito e o remetente de teste do Resend.
RESEND_FROM=CheckRoom <onboarding@resend.dev>
